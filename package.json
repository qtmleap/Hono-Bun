{
  "name": "typescript",
  "version": "0.2.0",
  "description": "TypeScript + Bun + Wrangler",
  "author": "@QuantumLeap",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bun run src/index.ts --watch",
    "build": "tsc -b --noEmit && bun build src/index.ts --outdir=dist --target=bun --platform=bun --drop console --minify",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --bun biome check",
    "format": "bunx --bun biome check --write",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.1",
    "dayjs": "^1.11.23",
    "hono": "^4.13.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.5.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
